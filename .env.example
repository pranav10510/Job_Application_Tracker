# Job Tracker Environment Variables
# Copy this file to .env and fill in your values

# Gmail Configuration
GMAIL_ADDRESS=your-email@gmail.com

# Optional: Web Search API Key (for research agent)
# Get from Google Custom Search or SerpAPI
WEB_SEARCH_API_KEY=

# Ollama Configuration (defaults are usually fine)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TIMEOUT=300
